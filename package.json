{
  "name": "palcm",
  "version": "0.3.2",
  "private": true,
  "description": "PSM Console by >GR477< - Palworld Server Manager",
  "author": "Alexis Joel Dávila (>GR477<)",
  "copyright": "Copyright © 2026 Alexis Joel Dávila (>GR477<)",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:backend": "npm run build:main",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start:dev": "set PALCM_RUNTIME_ENV=development&& npm run build && electron .",
    "start:test": "set PALCM_RUNTIME_ENV=test&& npm run build && electron .",
    "start:backend": "npm run build:backend",
    "electron:dev": "electron .",
    "dev": "npm run start:dev",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "extract-zip": "^2.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.palcm.servermanager",
    "productName": "PSM Console by GR477",
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/palcm-logo.ico",
        "to": "palcm-logo.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/palcm-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PalCM",
      "artifactName": "PalCM-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PalCM-Portable-${version}.${ext}"
    }
  }
}
