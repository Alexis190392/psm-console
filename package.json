{
  "name": "palcm",
  "version": "0.1.0",
  "private": true,
  "description": "Palworld Portable Server Manager",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start:dev": "set PALCM_RUNTIME_ENV=development&& npm run build && electron .",
    "start:test": "set PALCM_RUNTIME_ENV=test&& npm run build && electron .",
    "start": "electron .",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.palcm.servermanager",
    "productName": "Palworld Server Manager",
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
