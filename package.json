{
  "name": "palcm",
  "version": "0.19.2",
  "private": true,
  "description": "PSM Console by >GR477< - Palworld Server Manager",
  "author": "Alexis Joel Dávila (>GR477<)",
  "copyright": "Copyright © 2026 Alexis Joel Dávila (>GR477<)",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:backend": "npm run build:main",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start:dev": "set PALCM_RUNTIME_ENV=development&& npm run build && electron .",
    "start:test": "set PALCM_RUNTIME_ENV=test&& npm run build && electron .",
    "start:backend": "npm run build:backend",
    "electron:dev": "electron .",
    "dev": "npm run start:dev",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "validate:portable": "npm run build:main && node dist/tools/portable-artifact-validator.js",
    "capture:responsive": "npm run build && electron scripts/capture-responsive-screenshots.js",
    "capture:manual": "set PALCM_CAPTURE_MODE=manual&& npm run build && electron scripts/capture-responsive-screenshots.js",
    "capture:web": "electron scripts/capture-remote-api-screenshots.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "extract-zip": "^2.0.1",
    "lucide": "^1.24.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tar": "7.5.20"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.palcm.servermanager",
    "productName": "PSM Console by GR477",
    "extraMetadata": {
      "name": "palcm",
      "productName": "PSM Console by GR477",
      "description": "Palworld Server Manager",
      "author": "Alexis Joel Davila (>GR477<)"
    },
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/palcm-logo.ico",
        "to": "palcm-logo.ico"
      },
      {
        "from": "src/renderer/assets/palcm-logo.png",
        "to": "palcm-logo.png"
      },
      {
        "from": "resources/remote-api-web",
        "to": "remote-api-web"
      },
      {
        "from": "src/renderer/assets/palworld-world-map-1.0.webp",
        "to": "remote-api-web/palworld-world-map-1.0.webp"
      },
      {
        "from": "src/renderer/assets/palworld-tree-map-1.0.webp",
        "to": "remote-api-web/palworld-tree-map-1.0.webp"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "executableName": "PSM Console by GR477",
      "icon": "build/palcm-logo.ico",
      "legalTrademarks": "PSM Console by GR477",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PalCM",
      "artifactName": "PalCM-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PSM-Console-v${version}.${ext}"
    }
  }
}
